/-!
# Tail condition for the Black form at general positive total variance

For any everywhere-positive total variance `w`, the Black form `blackForm k (w k)` tends to 0 at
large `k` exactly when `d₊(k, w k)` tends to `-∞`.

## Main results

* `blackForm_tendsto_zero_iff_dpl_tendsto_atBot`: Tail condition for the Black form at general
  positive total variance

## References

* [Roper, *Arbitrage free implied volatility surfaces*][Roper2010]

## Tags

tail condition, black form, total variance, d plus, call price, no-arbitrage, smile, MSC 91G20
-/

set_option autoImplicit false

@[expose] public section

namespace MathFin

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

/-- For any everywhere-positive total variance `w`, the Black form `blackForm k (w k)` tends to
`0` as `k → +∞` iff `dpl k (w k)` tends to `-∞`. -/
theorem blackForm_tendsto_zero_iff_dpl_tendsto_atBot (w : ℝ → ℝ) (hw : ∀ k, 0 < w k) :
    Filter.Tendsto (fun k ↦ MathFin.ForwardSmile.blackForm k (w k)) Filter.atTop (nhds 0) ↔
      Filter.Tendsto (fun k ↦ MathFin.ForwardSmile.dpl k (w k)) Filter.atTop Filter.atBot := by
  have hnn (k : ℝ) : 0 ≤ ForwardSmile.blackForm k (w k) := by
    have hr : 0 < Real.sqrt (w k) := Real.sqrt_pos.2 (hw k)
    have hd1 : MathFin.bsd1 1 (Real.exp k) 0 (Real.sqrt (w k)) 1 =
        ForwardSmile.dpl k (w k) := by
      have h := ForwardSmile.bsd1_eq_dpl (F := 1) (k := k) one_ne_zero hr one_pos
      rwa [one_mul, mul_one, Real.sq_sqrt (hw k).le] at h
    have hd2 : MathFin.bsd2 1 (Real.exp k) 0 (Real.sqrt (w k)) 1 =
        ForwardSmile.dmi k (w k) := by
      rw [MathFin.bsd2, hd1]
      simp only [Real.sqrt_one, mul_one, ForwardSmile.dpl_eq, ForwardSmile.dmi_eq]
      ring
    have hb := MathFin.bsV_nonneg
      (show BSCallHyp (gaussianReal 0 1) 1 (Real.exp k) 0 (Real.sqrt (w k)) 1 id from
        ⟨one_pos, Real.exp_pos k, hr, one_pos, ⟨aemeasurable_id, Measure.map_id⟩⟩)
    simpa [ForwardSmile.blackForm, MathFin.bsV, hd1, hd2] using hb
  have hle (k : ℝ) : ForwardSmile.blackForm k (w k) ≤ Phi (ForwardSmile.dpl k (w k)) := by
    simp only [ForwardSmile.blackForm]
    linarith [mul_nonneg (Real.exp_pos k).le (Phi_nonneg (ForwardSmile.dmi k (w k)))]
  constructor
  · intro h
    rw [Filter.tendsto_atBot]
    by_contra hcon
    push_neg at hcon
    obtain ⟨b, hb⟩ := hcon
    have hfr : ∃ᶠ k in Filter.atTop, b < ForwardSmile.dpl k (w k) := by
      simpa [Filter.Eventually, Filter.Frequently, not_le] using hb
    sorry
  · intro h
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds
      (tendsto_Phi_atBot.comp h) (Filter.Eventually.of_forall hnn) (Filter.Eventually.of_forall hle)

end MathFin
