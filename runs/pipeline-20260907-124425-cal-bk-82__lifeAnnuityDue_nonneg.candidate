module

public import Mathlib
public import MathFin.Actuarial.Mortality

set_option autoImplicit false

@[expose] public section

namespace MathFin

-- apply: Finset.sum_nonneg, mul_nonneg, pow_nonneg, div_nonneg, survivalFromForce_pos
theorem lifeAnnuityDue_nonneg (μ : ℝ → ℝ) (x : ℝ) (n : ℕ) :
    ∀ i : ℝ, -1 < i → 0 ≤ lifeAnnuityDue μ x i n := by sorry

end MathFin
